# Discord Bot Gateway Configuration
CLIENT_ID=
DISCORD_TOKEN=
GUILD_ID=

# Roblox OAuth 2.0 App Configuration (Roblox Creator Dashboard)
# Set ROBLOX_CLIENT_ID to your OAuth 2.0 app's Client ID (e.g. numeric ID)
ROBLOX_CLIENT_ID=
# Set ROBLOX_CLIENT_SECRET to your OAuth 2.0 app's Client Secret
ROBLOX_CLIENT_SECRET=
# Set ROBLOX_REDIRECT_URI to the registered callback URL ending in /oauth/roblox/callback
ROBLOX_REDIRECT_URI=http://localhost:3000/oauth/roblox/callback

# Database Storage Configuration (Turso Cloud DB or leave empty for local SQLite fallback)
TURSO_AUTH_TOKEN=
TURSO_URL=