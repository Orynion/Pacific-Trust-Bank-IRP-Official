# Discord Bot Gateway Configuration
CLIENT_ID=
DISCORD_TOKEN=
GUILD_ID=1558112811513552977

# Bloxlink verification integration
# Create a guild API key in the Bloxlink developer dashboard for this server.
BLOXLINK_API_KEY=
# Discord role IDs copied from Server Settings > Roles (Developer Mode enabled).
BLOXLINK_VERIFIED_ROLE_ID=
REGISTERED_ROLE_ID=

# Treasury review configuration
TREASURY_REVIEW_CHANNEL_ID=
# Comma-separated Discord role IDs allowed to review receipts (admins always allowed).
TREASURY_REVIEWER_ROLE_IDS=

# Private ticket configuration
# Optional category that receives every new deposit/withdrawal ticket.
TICKET_CATEGORY_ID=
# Comma-separated role IDs that can close tickets and use /add-user.
# Administrators always count as ticket staff.
TICKET_STAFF_ROLE_IDS=
# Optional private staff channel for ticket open/close/decision logs and transcripts.
TICKET_LOG_CHANNEL_ID=

# Optional absolute path to the local tesseract binary used for automatic
# payment-amount OCR. Leave empty when `tesseract` is installed on PATH
# (for example system-wide on Bothost.net after installing tesseract-ocr).
TESSERACT_PATH=

# Database Storage Configuration (Turso Cloud DB or leave empty for local SQLite fallback)
TURSO_AUTH_TOKEN=
TURSO_URL=
